root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 3

# Dart's formatter is deliberately not configurable — `dart format` hardcodes a
# 2-space indent. Matching it here keeps editors from fighting the formatter.
[*.dart]
indent_size = 2

[*.{yml,yaml,md,json}]
indent_size = 2

[*.txt]
indent_style = space
indent_size = 1
